{"openapi":"3.1.0","info":{"title":"AI Paper Reviewer API","version":"1.0.0"},"paths":{"/":{"get":{"summary":"Root","description":"Serve the main upload page.","operationId":"root__get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/review":{"get":{"summary":"Review Page","description":"Serve the review viewing page.","operationId":"review_page_review_get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/tech-overview":{"get":{"summary":"Tech Overview Page","description":"Serve the tech overview page.","operationId":"tech_overview_page_tech_overview_get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/api/get-upload-url":{"post":{"summary":"Get Upload Url","description":"Generate a presigned URL for direct S3 upload.\n\nThis endpoint allows clients to upload files directly to S3 without\nrouting through the FastAPI server, improving scalability and performance.\n\nArgs:\n    data: Request containing filename and optional venue\n\nReturns:\n    JSON with presigned URL, S3 key, and upload instructions","operationId":"get_upload_url_api_get_upload_url_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PresignedUrlRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/confirm-upload":{"post":{"summary":"Confirm Upload","description":"Confirm an S3 upload and create a submission record.\n\nThis endpoint is called after the client has uploaded a file to S3 using\nthe presigned URL. It validates the upload and creates a submission record.\nThe actual file download happens later in the worker process.\n\nArgs:\n    s3_key: The S3 key of the uploaded file\n    venue: Optional venue information\n    email: User's email address\n\nReturns:\n    JSON with the access token for the review","operationId":"confirm_upload_api_confirm_upload_post","requestBody":{"content":{"application/x-www-form-urlencoded":{"schema":{"$ref":"#/components/schemas/Body_confirm_upload_api_confirm_upload_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/upload":{"post":{"summary":"Upload Paper","description":"Upload a paper PDF with metadata (legacy direct upload endpoint).\n\nThis endpoint supports direct file uploads for backward compatibility.\nNew clients should use the /api/get-upload-url and /api/confirm-upload flow.\n\nReturns:\n    JSON with the access token for the review","operationId":"upload_paper_api_upload_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_upload_paper_api_upload_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/status/{token}":{"get":{"summary":"Get Status","description":"Get the status of a submission.\n\nReturns:\n    JSON with submission status","operationId":"get_status_api_status__token__get","parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string","title":"Token"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/review/{token}":{"get":{"summary":"Get Review","description":"Get the review for a submission by token.\n\nReturns:\n    JSON with review content and sections","operationId":"get_review_api_review__token__get","parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string","title":"Token"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/feedback/{token}":{"post":{"summary":"Submit Feedback","description":"Submit feedback for a review.\n\nArgs:\n    token: The submission token\n    feedback: Feedback data including helpfulness, critical errors, and actionable suggestions\n\nReturns:\n    JSON confirmation of feedback submission","operationId":"submit_feedback_api_feedback__token__post","parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string","title":"Token"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FeedbackRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/googleadf49c1f2d465791.html":{"get":{"summary":"Google Verification","description":"Serve Google Search Console verification file.","operationId":"google_verification_googleadf49c1f2d465791_html_get","responses":{"200":{"description":"Successful Response","content":{"text/plain":{"schema":{"type":"string"}}}}}}},"/robots.txt":{"get":{"summary":"Robots","description":"Serve robots.txt for search engine crawlers.","operationId":"robots_robots_txt_get","responses":{"200":{"description":"Successful Response","content":{"text/plain":{"schema":{"type":"string"}}}}}}},"/sitemap.xml":{"get":{"summary":"Sitemap","description":"Serve sitemap.xml for search engines.","operationId":"sitemap_sitemap_xml_get","responses":{"200":{"description":"Successful Response"}}}},"/health":{"get":{"summary":"Health Check","description":"Health check endpoint.","operationId":"health_check_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/metrics":{"get":{"summary":"Get Metrics","description":"Get server metrics and load information.\n\nReturns:\n    JSON with server metrics including:\n    - uptime_seconds: Server uptime in seconds\n    - uptime_formatted: Human-readable uptime\n    - cpu_percent: CPU usage percentage\n    - memory_percent: Memory usage percentage\n    - memory_mb: Memory usage in MB\n    - thread_count: Number of threads","operationId":"get_metrics_api_metrics_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"Body_confirm_upload_api_confirm_upload_post":{"properties":{"s3_key":{"type":"string","title":"S3 Key"},"venue":{"type":"string","title":"Venue","default":""},"email":{"type":"string","title":"Email"}},"type":"object","required":["s3_key","email"],"title":"Body_confirm_upload_api_confirm_upload_post"},"Body_upload_paper_api_upload_post":{"properties":{"pdf":{"type":"string","format":"binary","title":"Pdf"},"venue":{"type":"string","title":"Venue","default":""},"email":{"type":"string","title":"Email"}},"type":"object","required":["pdf","email"],"title":"Body_upload_paper_api_upload_post"},"FeedbackRequest":{"properties":{"helpfulness":{"type":"integer","title":"Helpfulness"},"has_critical_error":{"type":"boolean","title":"Has Critical Error"},"has_actionable_suggestions":{"type":"boolean","title":"Has Actionable Suggestions"},"additional_comments":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Additional Comments"}},"type":"object","required":["helpfulness","has_critical_error","has_actionable_suggestions"],"title":"FeedbackRequest"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"PresignedUrlRequest":{"properties":{"filename":{"type":"string","title":"Filename"},"venue":{"type":"string","title":"Venue","default":""}},"type":"object","required":["filename"],"title":"PresignedUrlRequest"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}