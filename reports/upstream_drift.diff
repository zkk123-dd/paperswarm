-def _check_tool_card(cls: ast.ClassDef, rel: str, layer: Layer) -> None:
-    call = next(
-        (
-            node
-            for node in ast.walk(cls)
-            if isinstance(node, ast.Call) and _callee_name(node.func) == "ToolCard"
-        ),
-        None,
-    )
-    if call is None:
-        layer.warn(
-            f"{rel}: {cls.name} 内未找到字面量 ToolCard(...) 调用，"
