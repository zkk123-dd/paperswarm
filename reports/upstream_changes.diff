+# ---------------------------------------------------------------------------
+# Paper-capability specs (opt-in via the ``paper_swarm`` config section).
+#
+# These elements are deliberately NOT added to ``_COMMON_RAIL_NAMES`` /
+# ``_COMMON_TOOL_NAMES``. Those two tuples define the *default* member profile and
+# the assembly regression tests assert them as exact sets; a capability that is off
+# for every team that has not opted in must not widen them. Instead the paper specs
+# are appended only when ``paper_swarm.enabled`` is true, so a default team builds
+# exactly the same element set as before this change.
+#
+# Ordering note: the paper rails go *after* the evolution rails, because evolution
+# rails may rewrite the member prompt and the evidence protocol must win.
+# ---------------------------------------------------------------------------
+
+_PAPER_RAIL_NAMES: tuple[str, ...] = (
+    registry.PAPER_PROTOCOL_PROMPT,
+    registry.PAPER_GATE_AUDIT,
+)
+
+_PAPER_TOOL_NAMES: tuple[str, ...] = (
+    registry.PAPER_LEDGER_TOOLS,
+    registry.PAPER_ASSEMBLER_TOOLS,
+)
+
+#: The canonical ICLR-style section order used when the config omits ``sections``.
+_PAPER_DEFAULT_SECTIONS: tuple[tuple[str, str], ...] = (
+    ("introduction", "Introduction"),
+    ("related_work", "Related Work"),
+    ("method", "Method"),
+    ("experiments", "Experiments"),
+    ("discussion", "Discussion"),
+    ("conclusion", "Conclusion"),
+)
+
+
+def _paper_swarm_section(config: dict[str, Any]) -> dict[str, Any]:
+    """Return the ``paper_swarm`` config section as a dict (empty when absent)."""
+    section = (config or {}).get("paper_swarm", {})
+    return section if isinstance(section, dict) else {}
+
+
+def _paper_swarm_enabled(config: dict[str, Any]) -> bool:
+    """Return whether the paper capability is switched on for this config."""
+    return bool(_paper_swarm_section(config).get("enabled", False))
+
+
+def _paper_sections(config: dict[str, Any]) -> list[list[str]]:
+    """Resolve the section order, tolerating a malformed entry by falling back.
+
+    Each entry must be a two-element sequence ``[stem, Title]``. Anything else is
+    dropped rather than raising: a bad config must not fail team assembly.
+    """
+    raw = _paper_swarm_section(config).get("sections")
+    if not isinstance(raw, (list, tuple)):
+        return [list(item) for item in _PAPER_DEFAULT_SECTIONS]
+    cleaned: list[list[str]] = []
+    for entry in raw:
+        if isinstance(entry, (list, tuple)) and len(entry) >= 2:
+            stem, title = str(entry[0]).strip(), str(entry[1]).strip()
+            if stem and title:
+                cleaned.append([stem, title])
+    return cleaned or [list(item) for item in _PAPER_DEFAULT_SECTIONS]
+
+
+def _paper_common_params(config: dict[str, Any]) -> dict[str, Any]:
+    """Attribute params shared by every paper element."""
+    section = _paper_swarm_section(config)
+    return {"sections_subdir": str(section.get("sections_subdir") or "sections")}
+
+
+def _paper_ledger_tool_params(config: dict[str, Any]) -> dict[str, Any]:
+    """Attribute params for the evidence-ledger toolset."""
+    params = _paper_common_params(config)
+    params["compact"] = bool(_paper_swarm_section(config).get("compact", True))
+    return params
+
+
+def _paper_assembler_tool_params(config: dict[str, Any]) -> dict[str, Any]:
+    """Attribute params for the assembly/compile toolset (paths + title + order)."""
+    section = _paper_swarm_section(config)
+    params = _paper_common_params(config)
+    params.update(
+        {
+            "template_dir": str(section.get("template_dir") or ""),
+            "tectonic_path": str(section.get("tectonic_path") or ""),
+            "bundle_path": str(section.get("bundle_path") or ""),
+            "cache_dir": str(section.get("cache_dir") or ""),
+            "pdf_title": str(section.get("title") or ""),
+            "sections": _paper_sections(config),
+        }
+    )
+    return params
+
+
+def _paper_rail_params(config: dict[str, Any]) -> dict[str, Any]:
+    """Attribute params for both paper rails (they only need the sections dir)."""
+    return _paper_common_params(config)
+
+
 # Per-element attribute params, keyed by provider name; empty for parameterless.
