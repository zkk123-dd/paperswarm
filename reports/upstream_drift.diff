+def _check_legacy_camel_keys(obj: Any, layer: Layer, prefix: str = "") -> None:
+    """Reject leftover camelCase manifest keys; canonical names are snake_case."""
+    if not isinstance(obj, dict):
+        return
+    for old, new in _LEGACY_CAMEL_KEYS.items():
+        if old not in obj:
+            continue
