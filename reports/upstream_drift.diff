-        )
-        return
-    kwargs = {kw.arg: kw.value for kw in call.keywords if kw.arg}
-    for key in ("id", "name"):
-        if key not in kwargs:
-            layer.error(f"{rel}: ToolCard 必须显式设置 {key!r}")
-    params = kwargs.get("input_params")
-    if params is None:
-        layer.error(
-            f"{rel}: ToolCard 必须设置 input_params",
