-        )
-        return
-    has_object_type = any(
-        isinstance(key, ast.Constant)
-        and key.value == "type"
-        and isinstance(value, ast.Constant)
-        and value.value == "object"
-        for key, value in zip(params.keys, params.values)
-    )
-    if not has_object_type:
-        layer.error(
-            f'{rel}: input_params 必须含 "type": "object"',
