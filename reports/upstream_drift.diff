+    if not isinstance(first, dict):
+        return
+    if any(default_input.get(lang) != first.get(lang) for lang in ("en", "zh")):
+        layer.error(
+            "manifest.json: default_init_input 必须与 quick_inputs[0] 完全一致",
+            "把 quick_inputs 第一条原样复制到 default_init_input",
+        )
+
