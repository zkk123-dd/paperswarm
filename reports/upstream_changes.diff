+def _paper_capability_specs(
+    config: dict[str, Any],
+) -> tuple[list[RailSpec], list[BuiltinToolSpec]]:
+    """Build the opt-in paper capability specs.
+
+    Returns empty lists unless ``paper_swarm.enabled`` is true, so a team that has not
+    opted in keeps exactly the element set it had before this capability existed.
+
+    Args:
+        config: The resolved ``config.yaml`` mapping.
+
+    Returns:
+        A ``(rails_specs, tool_specs)`` tuple, both empty when the gate is closed.
+    """
+    if not _paper_swarm_enabled(config):
+        return [], []
+    rails_specs = [
+        RailSpec(type=name, params=_rail_params(name, config))
+        for name in _PAPER_RAIL_NAMES
+    ]
+    tool_specs = [
+        BuiltinToolSpec(type=name, params=_tool_params(name, config))
+        for name in _PAPER_TOOL_NAMES
+    ]
+    return rails_specs, tool_specs
 
 
